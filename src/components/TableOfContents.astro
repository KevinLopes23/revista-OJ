---
import { Image } from "astro:assets";
import SectionDivider from "./SectionDivider.astro";
import historia from "../assets/photos/history-necklace-egypt.jpg";
import tessalia from "../assets/photos/guell-barcelona.jpg";
import pecaAutoral from "../assets/photos/trencadis-pingente-2.jpg";
import oficina from "../assets/photos/craft-fachada.jpg";
import entrevista from "../assets/photos/elaine-retrato.jpg";

const items = [
  { href: "#historia", img: historia, alt: "Colar egípcio de ouro em formato de gola", title: "Por que usamos joias?", desc: "Um mergulho na história da joalheria, buscando entender as intenções humanas desde a antiguidade." },
  { href: "#tessalia", img: tessalia, alt: "Bancos de mosaico do Park Güell, em Barcelona", title: "Tessalia, arte em fragmentos", desc: "Pesquisas, desenvolvimento e a arte envolvida na elaborada coleção primavera/verão 2026 OJ." },
  { href: "#peca-autoral", img: pecaAutoral, alt: "Pingente Trencadís de perto, com as pedras coloridas encravadas", title: "Trencadís, um pingente autoral", desc: "A criação do pingente autoral que traduz em formas e cores a inspiração dos mosaicos de Tessalia." },
  { href: "#oficina", img: oficina, alt: "Fachada da Oficina das Joias, com o logo dourado sobre fundo azul", title: "A Oficina das Joias", desc: "A dedicação e qualidade da tradição de mais de 70 anos, unidas à inovação e tecnologia." },
  { href: "#entrevista", img: entrevista, alt: "Elaine Batista Corrales sorrindo ao ar livre", title: "Entrevista com Elaine", desc: "Sobre a sua trajetória na OJ." },
  // the coloring card lives in public/ (served byte-for-byte for the game's
  // flood-fill), so it comes in as a plain <img> rather than astro:assets
  { href: "#pinte", raw: "/game/mosaic-lineart.png", alt: "Traço do mosaico do cartão de colorir", title: "Pinte o mosaico", desc: "Uma versão digital do cartão de colorir que acompanha esta edição." },
];
---

<section class="toc" id="sumario" aria-labelledby="toc-heading">
  <SectionDivider variant="blue" />
  <div class="container">
    <h2 id="toc-heading" data-reveal>Sumário</h2>
    <ol>
      {
        items.map((item) => (
          <li>
            <a href={item.href}>
              <span class="thumb">
                {item.img ? (
                  <Image src={item.img} alt={item.alt} widths={[160, 280]} sizes="(min-width: 40rem) 7.5rem, 5.5rem" />
                ) : (
                  <img src={item.raw} alt={item.alt} width="280" height="280" loading="lazy" decoding="async" />
                )}
              </span>
              <span class="text">
                <span class="title">{item.title}</span>
                <span class="desc">{item.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <SectionDivider variant="pink" flip />
</section>

<style>
  .toc .container {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 46rem;
  }

  h2 {
    font-style: italic;
    font-size: var(--fs-h2);
    margin-bottom: 1.5em;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  li {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
  }

  a {
    text-decoration: none;
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    align-items: center;
  }

  @media (min-width: 40rem) {
    a {
      grid-template-columns: 7rem 1fr;
      gap: 1.4rem;
    }
  }

  .thumb {
    display: block;
    overflow: hidden;
    border-radius: 3px;
  }

  .thumb :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a:hover .thumb :global(img),
  a:focus-visible .thumb :global(img) {
    transform: scale(1.07);
  }

  .text {
    display: grid;
    gap: 0.3rem;
  }

  .title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.5rem);
  }

  a:hover .title,
  a:focus-visible .title {
    color: var(--p-crimson);
  }

  .desc {
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    max-width: 34rem;
  }
</style>
