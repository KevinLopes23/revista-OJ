---
const phone = "5514997316864";
const message = "Olá! Vim pela Revista OJ e gostaria de mais informações.";
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class="wa"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Falar com a Oficina das Joias no WhatsApp"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.82 11.82 0 0 0 20.465 3.488"
    ></path>
  </svg>
  <span class="tip">Fale conosco</span>
</a>

<style>
  .wa {
    --wa-green: #25d366;
    position: fixed;
    z-index: 60;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: center;
    /* no gap: it would hold its width against the collapsed label and pull
       the icon off centre. The label carries its own inset instead. */
    padding: 0.75rem;
    border-radius: 999px;
    background: var(--wa-green);
    color: var(--p-white);
    text-decoration: none;
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.45);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s ease;
  }

  .wa svg {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }

  /* the label only unfolds on pointer devices, where there is room for it */
  .tip {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    white-space: nowrap;
    max-width: 0;
    padding-inline: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease,
      padding-inline 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (min-width: 40rem) {
    .wa:hover,
    .wa:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px -8px rgba(0, 0, 0, 0.5);
    }

    .wa:hover .tip,
    .wa:focus-visible .tip {
      max-width: 9rem;
      opacity: 1;
      padding-inline: 0.6rem 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa,
    .tip {
      transition: none;
    }
  }
</style>
